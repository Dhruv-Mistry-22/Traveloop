// Traveloop — PostgreSQL schema via Prisma
// Targets Neon (PostgreSQL). Use pooled connections in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Neon pooled `-pooler` host — runtime / Prisma Client.
  url       = env("DATABASE_URL")
  /// Neon direct host (no `-pooler`) — `migrate`, `db push`, introspection (see Neon docs).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — database-level enums keep values consistent across app & SQL
// ---------------------------------------------------------------------------

/// Lifecycle of a planned or active trip for filtering dashboards.
enum TripStatus {
  DRAFT // user is still assembling itinerary
  PLANNED // schedule mostly fixed, not yet started
  ACTIVE // within travel window / in progress
  COMPLETED // trip finished successfully
  CANCELLED // abandoned trip
}

/// High-level budgeting categories for rollup reports.
enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITY
  SHOPPING
  INSURANCE
  MISC
}

/// Helps organize packing UX (filters/sorts) without rigid taxonomy.
enum PackingCategory {
  CLOTHING
  TOILETRIES
  DOCUMENTS
  ELECTRONICS
  GEAR
  OTHER
}

// ---------------------------------------------------------------------------
// User & profile layer
// ---------------------------------------------------------------------------

/// Core identity row. Owns trips, saved places, preferences.
/// Exists to centralize credentials and personalization for all modules.
model User {
  id String @id @default(cuid())

  /// Unique login identifier; enforced for lookups and resets.
  email String @unique

  /// Argon2/bcrypt digest only — never plaintext.
  passwordHash String @map("password_hash")

  name         String?
  /// Optional CDN URL / avatar metadata for profile module.
  imageUrl     String? @map("image_url")
  emailVerifiedAt DateTime? @map("email_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preference        UserPreference?
  savedDestinations SavedDestination[]
  trips             Trip[]

  @@map("users")
}

/// 1:1 extension for UI defaults and personalization.
/// Split from User so large/complex prefs do not widen hot auth reads.
model UserPreference {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ISO 639-1 or BCP47 language tag(s), comma-separated optional.
  language    String?
  /// ISO 4217 currency preferred for aggregates (e.g. USD).
  currency    String @default("USD") @db.Char(3)
  /// IANA TZ for reminders (text to avoid brittle DB TZ coupling).
  timeZone    String? @map("time_zone")

  dietaryNotes String? @map("dietary_notes")

  notificationsEmail Boolean @default(true) @map("notifications_email")
  notificationsPush  Boolean @default(true) @map("notifications_push")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_preferences")
}

/// Bookmarks destinations independent of trips (research / reuse).
model SavedDestination {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  country   String // ISO 3166-1 alpha-2 recommended at app layer
  city      String
  region    String?
  label     String? // nickname "Mom's hometown"
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, country, city])
  @@map("saved_destinations")
}

// ---------------------------------------------------------------------------
// Trip graph — itineraries, stops, activities
// ---------------------------------------------------------------------------

/// Umbrella itinerary per travel window / multi-city plan.
model Trip {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime? @map("ends_on") @db.Date

  status TripStatus @default(DRAFT)

  /// Derived flag cached for dashboards; enforced in app when >1 Stop.
  isMultiCity Boolean @default(false) @map("is_multi_city")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stops         Stop[]
  expenses      Expense[]
  packingItems  PackingItem[]
  notes         Note[]
  sharedLinks   SharedLink[]

  @@index([userId, startsOn])
  @@index([userId, status])
  @@map("trips")
}

/// Ordered leg of a trip (city/region granularity).
/// Separates geography from granular Activity rows for clean 1-many flows.
model Stop {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  city    String
  country String @db.Char(2) // ISO-3166-1 alpha-2

  arrivesOn  DateTime? @map("arrives_on") @db.Date
  departsOn  DateTime? @map("departs_on") @db.Date

  /// User-defined ordering inside a trip itinerary.
  orderIndex Int @map("order_index")

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  logisticsNotes String? @map("logistics_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities Activity[]
  expenses   Expense[] @relation("StopExpenses")

  @@unique([tripId, orderIndex])
  @@index([tripId, arrivesOn])
  @@map("stops")
}

/// Time-boxed itinerary item anchored to a stop.
model Activity {
  id String @id @default(cuid())

  stopId String @map("stop_id")
  stop   Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  title       String
  description String?

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  /// Optional budgeting hint distinct from ledger Expense rows.
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 2)

  locationHint String? @map("location_hint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[] @relation("ActivityExpenses")

  @@index([stopId, startsAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Budget ledger
// ---------------------------------------------------------------------------

/// Atomic money movement tied primarily to Trip; optionally scoped narrower.
model Expense {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  stopId String? @map("stop_id")
  stop   Stop?   @relation("StopExpenses", fields: [stopId], references: [id], onDelete: SetNull)

  activityId String?   @map("activity_id")
  activity   Activity? @relation("ActivityExpenses", fields: [activityId], references: [id], onDelete: SetNull)

  category ExpenseCategory
  amount   Decimal         @db.Decimal(12, 2)
  /// ISO currency for this row (handles multi-currency trips).
  currency String          @db.Char(3)

  vendor   String?
  memo     String?
  spentOn  DateTime        @default(now()) @map("spent_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId, spentOn])
  @@index([tripId, category])
  @@index([stopId])
  @@index([activityId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Supporting modules
// ---------------------------------------------------------------------------

/// Checklist scoped to Trip for packing collaboration simplicity.
model PackingItem {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name     String
  category PackingCategory @default(OTHER)

  isPacked Boolean @default(false) @map("is_packed")
  quantity Int     @default(1)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId, isPacked])
  @@index([tripId, category])
  @@map("packing_items")
}

/// Lightweight journal/reminder attached to Trip.
model Note {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  title  String?
  body   String
  pinned Boolean @default(false)

  reminderAt DateTime? @map("reminder_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId, pinned])
  @@index([tripId, reminderAt])
  @@map("notes")
}

/// Public-share surface for itineraries; avoids exposing sequential IDs.
model SharedLink {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Opaque bearer token surfaced in URLs; rotate by replacing row.
  token String @unique @default(cuid())

  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  allowExpensesVisibility Boolean @default(false) @map("allow_expenses_visibility")

  title       String?
  description String?

  viewCount Int @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId])
  @@map("shared_links")
}
