# Copy to `.env`. Names match Neon docs (Connect → Prisma).
#
# Pooled URL only — add Prisma pool tuning so Studio / Neon don’t starve (see Prisma “connection pool” docs):
#   &connection_limit=5   (default was ~17 on many PCs; Neon pool is small)
#   &pool_timeout=30      (seconds — avoids “Timed out fetching a new connection…” in Studio)
# Direct URL keeps only connect_timeout unless Neon asks for more.

# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&connection_limit=5&pool_timeout=30"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

DATABASE_URL=""
DIRECT_URL=""
